option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: apollo/wsgi.py
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: apollo.settings
    DJANGO_DEBUG: False
    DJANGO_ALLOWED_HOSTS: ".elasticbeanstalk.com,localhost,127.0.0.1"
    DJANGO_SUPERUSER_USERNAME: admin
    DJANGO_SUPERUSER_EMAIL: admin@apollo.local
    DJANGO_SUPERUSER_PASSWORD: apollo2026!
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles
container_commands:
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "python manage.py collectstatic --noinput"
    leader_only: true
  03_createsuperuser:
    command: "python manage.py createsuperuser --noinput || true"
    leader_only: true
  04_permissao_arquivo_sqlite:
    command: "chmod 666 db.sqlite3"
  05_permissao_pasta_sqlite:
    command: "chmod 777 ."
